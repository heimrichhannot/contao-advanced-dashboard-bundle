{
  "name": "heimrichhannot/contao-advanced-dashboard-bundle",
  "type": "contao-bundle",
  "description": "A bundle to customize the contao backend dashboard.",
  "license": "LGPL-3.0-or-later",
  "require": {
    "php": "^8.4",
    "contao/core-bundle": "^5.7",
    "contao/manager-plugin": "^2.0",
    "doctrine/dbal": "^3.7 || ^4.3",
    "symfony/config": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/event-dispatcher-contracts": "^3.0",
    "symfony/http-foundation": "^7.4",
    "symfony/http-kernel": "^7.4",
    "symfony/routing": "^7.4",
    "symfony/security-bundle": "^7.4",
    "symfony/security-core": "^7.4",
    "symfony/translation-contracts": "^3.0",
    "symfony/yaml": "^7.4"
  },
  "require-dev": {
    "contao/test-case": "^5.7"
  },
  "autoload": {
    "psr-4": {
      "HeimrichHannot\\AdvancedDashboardBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HeimrichHannot\\AdvancedDashboardBundle\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "contao-components/installer": true,
      "contao/manager-plugin": true,
      "php-http/discovery": false
    }
  },
  "extra": {
    "contao-manager-plugin": "HeimrichHannot\\AdvancedDashboardBundle\\ContaoManager\\Plugin"
  }
}
