{% trans_default_domain 'contao_default' %}

{% block dashboard %}
<div id="tl_soverview">

    {% block dashboard_top %}{% endblock %}

    {% block messages %}
        <div id="tl_messages">
            <h2>{{ systemMessages|default('Alerts') }}</h2>
            {{ messages|default|raw }}
            <p>{{ loginMsg|default|raw }}</p>
        </div>
    {% endblock %}

    {% block before_shortcuts %}{% endblock %}

    {% block shortcuts %}
        <div id="tl_shortcuts">
            <h2>{{ shortcuts|default }}</h2>
            <p>{{ shortcutsLink|default|raw }}</p>
        </div>
    {% endblock %}

    {% block before_versions %}{% endblock %}

    {% block versions %}
        <div id="tl_versions">
            <h2>{{ 'MSC.latestChanges'|trans }}</h2>
            {% if versions|default %}
                <table class="tl_listing with-border with-padding">
                    {% if columns|default %}
                        <thead>
                        <tr>
                            {% for column in columns %}
                                <th class="{{ column.class|default }}">{{ column.label|default }}</th>
                            {% endfor %}
                        </tr>
                        </thead>
                    {% endif %}
                    <tbody>
                    {% for version in versions %}
                        <tr class="{{ version.class|default }} click2edit hover-row">
                            {% for key, column in version.cols %}
                                <td class="{{ columns[key].class|default }}">{{ column|raw }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {{ pagination|default|raw }}
            {% else %}
                <p>{{ 'MSC.noVersions'|trans }}</p>
            {% endif %}
        </div>
    {% endblock %}

    {% block dashboard_bottom %}
        {% block credits %}
            <div id="tl_credits">
                <p style="float:right;font-size:0.9em;padding-top:18px;">
                    <a href="https://github.com/heimrichhannot/contao-advanced-dashboard-bundle" target="_blank" rel="noopener noreferrer">Advanced Dashboard</a>
                    by
                    <a href="https://www.heimrich-hannot.de" style="font-style:italic;" target="_blank" rel="noopener noreferrer">Heimrich+Hannot</a>
                </p>
                <div class="clear"></div>
            </div>
        {% endblock %}
    {% endblock %}

</div>
{% endblock %}
