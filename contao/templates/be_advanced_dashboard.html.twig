{% trans_default_domain 'contao_default' %}

{% block dashboard %}
<div id="tl_soverview">

    {% block messages %}
        <div id="tl_messages">
            <h2>{{ systemMessages|default('Alerts') }}</h2>
            {{ messages|default|raw }}
            <p>{{ loginMsg|default|raw }}</p>
        </div>
    {% endblock %}

    {% block shortcuts %}
        <div id="tl_shortcuts">
            <h2>{{ shortcuts|default }}</h2>
            <p>{{ shortcutsLink|default|raw }}</p>
        </div>
    {% endblock %}

    {% block versions %}
        <div id="tl_versions">
            <h2>{{ 'MSC.latestChanges'|trans }}</h2>
            {% if versions|default %}
                <table class="tl_listing with-border with-padding">
                    <thead>
                    <tr>
                        <th>{{ 'MSC.date'|trans }}</th>
                        <th>{{ 'MSC.user'|trans }}</th>
                        <th>{{ 'MSC.table'|trans }}</th>
                        <th>ID</th>
                        <th>{{ 'MSC.description'|trans }}</th>
                        <th>{{ 'MSC.version'|trans }}</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for version in versions %}
                        <tr class="hover-row" data-controller="contao--deeplink contao--operations-menu" data-action="contextmenu->contao--operations-menu#open">
                            <td>{{ version.date }}</td>
                            <td>{{ version.username ?: '-' }}</td>
                            <td>{{ version.shortTable }}</td>
                            <td>{{ version.pid }}</td>
                            <td>{{ version.description ?: '-' }}</td>
                            <td>
                                {% if version.active %}<strong>{% endif %}
                                    {{ version.version }}
                                    {% if version.active %}</strong>{% endif %}
                            </td>
                            <td class="tl_right_nowrap">{{ version.operations }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% include '@Contao/backend/component/_pagination.html.twig' with {
                    pagination: pagination
                } %}
            {% else %}
                <p>{{ 'MSC.noVersions'|trans }}</p>
            {% endif %}
        </div>
    {% endblock %}

    {% block credits %}
        <div id="tl_credits">
            <p style="float:right;font-size:0.9em;padding-top:18px;">
                <a href="https://github.com/heimrichhannot/contao-advanced-dashboard-bundle" target="_blank" rel="noopener noreferrer">Advanced Dashboard</a>
                by
                <a href="https://www.heimrich-hannot.de" style="font-style:italic;" target="_blank" rel="noopener noreferrer">Heimrich+Hannot</a>
            </p>
            <div class="clear"></div>
        </div>
    {% endblock %}

</div>
{% endblock %}
